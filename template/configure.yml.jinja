---
# Configuration pass for the {{ tenant }} operations platform — ingress
# routes, app directories, .env, .env.secret, container re-creation.
# Safe to re-run often; assumes provision.yml has already run on the host.
# Not a deploy: deploying is the verb's act (PLX-Deploy); this playbook binds
# apps to the host and hands them their environment (PLX-Platform).
#
#   mise configure
#
- name: Configure the {{ tenant }} operations platform
  hosts: {{ tenant }}
  become: true
  roles:
    - plexus.platform.configure_ingress
    - plexus.platform.configure_apps
